| .control
| save all
| * Each point is a COLD-START, SETTLED transient, not a bare
| * unconstrained .op (issue #172, contract #171): `uic` starts every node
| * at its natural cold value with EN low (the testbench's VEN steps high
| * at 101us), so the block powers up through its own soft-start ramp and
| * no operating-point solve happens at all. v(vout) is averaged over the
| * settled 199ms-200ms tail. See the testbench header for why a seeded
| * `op` cannot deliver this, and sim/load-regulation for why the window
| * is this long (that bench's 0mA point needs it; these four do not, but
| * both benches carry one convention).
| * EN convention (issue #196): EN's high level is the INSTANTANEOUS VIN,
| * not the corner runner's 'vsup' label. On this bench those are
| * different quantities -- VVIN is the bench's own source, 'alter'ed
| * between 2.97V and 3.63V INSIDE every corner, while 'vsup' is fixed per
| * corner -- so the old convention put EN 0.66V BELOW VIN at the
| * VIN=3.63V point of every *_2.97v corner. That is #187's EN-below-VIN
| * geometry (five PMOS shutdown clamps whose sources are VIN; gate drive
| * is VIN-EN), and it leaves no solver diagnostic. Each point below
| * therefore sets ONE literal (`vinpt`) and points BOTH VVIN and VEN's
| * pwl high level at it, so the two cannot drift apart in a later edit.
| * design/README.md -> 'Enable/shutdown' specifies EN as 'active-high,
| * full-rail (0V / VIN)', so this restores the documented interface at
| * every measured point; no spec or schematic line moves.
| * --- point 1: VIN=2.97V, I_LOAD=1mA (deck default) ---
| set vinpt = 2.97
| alter vvin = $vinpt
| alter @ven[pwl] = [ 0 0 100u 0 101u $vinpt 10 $vinpt ]
| tran 10u 200m uic
| meas tran vout_1ma_lo avg v(vout) from=199m to=200m
| * --- point 2: VIN=3.63V, I_LOAD=1mA ---
| set vinpt = 3.63
| alter vvin = $vinpt
| alter @ven[pwl] = [ 0 0 100u 0 101u $vinpt 10 $vinpt ]
| tran 10u 200m uic
| meas tran vout_1ma_hi avg v(vout) from=199m to=200m
| * --- point 3: VIN=2.97V, I_LOAD=50mA (altered) ---
| alter iload = 50m
| set vinpt = 2.97
| alter vvin = $vinpt
| alter @ven[pwl] = [ 0 0 100u 0 101u $vinpt 10 $vinpt ]
| tran 10u 200m uic
| meas tran vout_50ma_lo avg v(vout) from=199m to=200m
| * --- point 4: VIN=3.63V, I_LOAD=50mA ---
| set vinpt = 3.63
| alter vvin = $vinpt
| alter @ven[pwl] = [ 0 0 100u 0 101u $vinpt 10 $vinpt ]
| tran 10u 200m uic
| meas tran vout_50ma_hi avg v(vout) from=199m to=200m
| let meas_line_reg_1ma_mv_per_v = abs(1000*(tran2.vout_1ma_hi - tran1.vout_1ma_lo)/(3.63-2.97))
| let meas_line_reg_50ma_mv_per_v = abs(1000*(tran4.vout_50ma_hi - tran3.vout_50ma_lo)/(3.63-2.97))
| print meas_line_reg_1ma_mv_per_v
| print meas_line_reg_50ma_mv_per_v
| quit
| .endc
| .end

# ==== .spiceinit (2nd input: ngspice reads it from the run directory) ====
# sha256: 3cf811e1ae5fc75dd0bbe56205016c387c3538304be0cbdab7cb658fb9adf960
| * ngspice init settings for the sky130 PDK model libraries.
| *
| * The corner runner copies this file into its scratch run directory as
| * `.spiceinit` before invoking ngspice, so runs do not depend on whatever
| * happens to be in ~/.spiceinit. To drive ngspice by hand with the same
| * settings, copy this file to `.spiceinit` in your working directory.
| *
| * Same settings as the sibling sky130-bandgap harness (same PDK, same pin):
| * derived from the PDK's own libs.tech/ngspice/spinit, kept in-repo so the
| * settings a record was produced under are versioned with the harness.
| 
| set ngbehavior=hsa     ; HSPICE-ish compatibility, required to read PDK libs
| set skywaterpdk        ; skip some checks for faster lib loading
| set ng_nomodcheck      ; do not check model parameters
| option noinit          ; do not dump operating point data into the log
| option klu             ; KLU direct linear solver

