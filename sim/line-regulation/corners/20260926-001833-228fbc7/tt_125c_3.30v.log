| alter vvin = 3.63
| tran 10u 200m uic
| meas tran vout_50ma_hi avg v(vout) from=199m to=200m
| let meas_line_reg_1ma_mv_per_v = abs(1000*(tran2.vout_1ma_hi - tran1.vout_1ma_lo)/(3.63-2.97))
