| .control
| save all
| * --- leg 1: 50 mA operating point (RFORCE open) -- the clamp must be OFF ---
| op
| * --- leg 2: DC limit characteristic, VOUT forced from 0 V up to 1.75 V ---
| alter rload = 1e12
| alter rforce = 1m
| dc vforce 0 1.75 0.125
| meas dc ilim_short find i(vforce) at=0
| meas dc ilim_knee find i(vforce) at=1.75
| * --- leg 3: Vout=0 short applied at t=0.5ms and HELD to t=2.5ms ---
| alter rload = 36
| tran 500n 2.5m
| meas tran ipre avg i(vvin) from=0.4m to=0.5m
| meas tran ish_avg avg i(vvin) from=1.5m to=2.5m
| meas tran ish_max max i(vvin) from=0.6m to=2.5m
| meas tran ish_min min i(vvin) from=0.6m to=2.5m
| meas tran vsh_max max v(vout) from=0.6m to=2.5m
| let meas_vout_50ma_v = op1.v(vout)
| let meas_cl_margin_50ma_v = op1.v(vin) - op1.v(xldo.cl_cmp)
| let meas_ilim_short_ma = 1000*dc1.ilim_short
| let meas_ilim_knee_ma = 1000*dc1.ilim_knee
| let meas_ilim_droop_pct = 100*(dc1.ilim_knee - dc1.ilim_short)/dc1.ilim_knee
| let meas_ishort_sustained_ma = -1000*tran1.ish_avg
| let meas_ishort_ripple_pct = 100*(tran1.ish_max - tran1.ish_min)/(-tran1.ish_avg)
| let meas_vout_short_mv = 1000*tran1.vsh_max
| let meas_isup_pre_short_ma = -1000*tran1.ipre
| print meas_vout_50ma_v
| print meas_cl_margin_50ma_v
| print meas_ilim_short_ma
| print meas_ilim_knee_ma
| print meas_ilim_droop_pct
| print meas_ishort_sustained_ma
| print meas_ishort_ripple_pct
| print meas_vout_short_mv
| print meas_isup_pre_short_ma
| quit
| .endc
| .end

