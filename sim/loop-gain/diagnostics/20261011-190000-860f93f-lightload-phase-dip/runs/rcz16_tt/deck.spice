alter cout = 4.7e-06
alter hesr gain = 0.01
alter rload = 36
op
let vseed = v(vout)
let ivin = -i(vvin)
echo PT10_OP
print vseed ivin
ac dec 30 1e-2 1e+09
let lg = v(xldo.fb)/(1-v(xldo.fb))
let lgdb = db(lg)
let lgph = cph(lg)
wrdata resp_leg10.txt lg v(xldo.ea_out) v(xldo.ea_cz) v(vout) v(xldo.fb) v(xldo.ea_d1) v(xldo.ea_tail)
meas ac fc when lgdb=0 cross=1
meas ac phc find lgph when lgdb=0 cross=1
meas ac gmdb find lgdb when lgph=-180 cross=1
let dcg = lgdb[0]
echo PT10_AC
print fc
print phc
print gmdb
print dcg
quit
.endc
.end
