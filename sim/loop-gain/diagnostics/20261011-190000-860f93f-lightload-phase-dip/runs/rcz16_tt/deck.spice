.control
save all
set numdgt=10
set units=degrees
set wr_vecnames
set wr_singlescale
* --- leg 1: 0.33u/10m/0mA ---
alter cout = 3.3e-07
alter hesr gain = 0.01
alter rload = 1e+12
op
let vseed = v(vout)
let ivin = -i(vvin)
echo PT1_OP
print vseed ivin
ac dec 30 1e-2 1e+09
let lg = v(xldo.fb)/(1-v(xldo.fb))
let lgdb = db(lg)
let lgph = cph(lg)
wrdata resp_leg1.txt lg v(xldo.ea_out) v(xldo.ea_cz) v(vout) v(xldo.fb) v(xldo.ea_d1) v(xldo.ea_tail)
meas ac fc when lgdb=0 cross=1
meas ac phc find lgph when lgdb=0 cross=1
meas ac gmdb find lgdb when lgph=-180 cross=1
let dcg = lgdb[0]
echo PT1_AC
print fc
print phc
print gmdb
print dcg
