{
  "analysis_steps": [
    {
      "analysis": {
        "args": "5u 4.5m",
        "kind": "tran"
      },
      "measurements": [
        {
          "name": "vpre",
          "spice": ".meas tran vpre find v(vout) at=1.9m"
        },
        {
          "name": "iq_avg",
          "spice": ".meas tran iq_avg avg i(vvin) from=3.5m to=4.5m"
        },
        {
          "name": "iq_worst",
          "spice": ".meas tran iq_worst min i(vvin) from=3.5m to=4.5m"
        },
        {
          "name": "vhold",
          "spice": ".meas tran vhold find v(vout) at=4m"
        }
      ],
      "name": "tran1"
    },
    {
      "analysis": {
        "args": "",
        "kind": "op"
      },
      "measurements": [
        {
          "expr": "-1e6*i(vvin)",
          "name": "iq_shutdown_static_ua",
          "unit": "uA"
        },
        {
          "expr": "v(vout)",
          "name": "vout_disabled_static_v",
          "unit": "V"
        }
      ],
      "name": "op1"
    },
    {
      "alter": {
        "rforce": 0.001
      },
      "analysis": {
        "args": "",
        "kind": "op"
      },
      "measurements": [
        {
          "expr": "1e6*i(vforce)",
          "name": "leak_vin_vout_ua",
          "unit": "uA"
        }
      ],
      "name": "op2"
    },
    {
      "alter": {
        "rforce": 0.001,
        "vforce": 1.8
      },
      "analysis": {
        "args": "",
        "kind": "op"
      },
      "measurements": [
        {
          "expr": "-1e6*i(vforce)",
          "name": "ivout_held_1v8_ua",
          "unit": "uA"
        }
      ],
      "name": "op3"
    }
  ],
  "batch": {
    "capacity_wait_s": 10800
  },
  "corners": {
    "process": [
      "tt"
    ],
    "temperature_c": [
      27.0
    ]
  },
  "engine": "ngspice",
  "measurements": [
    {
      "expr": "op1.iq_shutdown_static_ua",
      "name": "meas_iq_shutdown_static_ua",
      "unit": "uA"
    },
    {
      "expr": "-1e6*tran1.iq_worst",
      "name": "meas_iq_shutdown_after_edge_ua",
      "unit": "uA"
    },
    {
      "expr": "-1e6*tran1.iq_avg",
      "name": "meas_iq_shutdown_after_edge_mean_ua",
      "unit": "uA"
    },
    {
      "expr": "op2.leak_vin_vout_ua",
      "name": "meas_leak_vin_vout_ua",
      "unit": "uA"
    },
    {
      "expr": "tran1.vpre",
      "name": "meas_vout_pre_disable_v",
      "unit": "V"
    },
    {
      "expr": "tran1.vhold",
      "name": "meas_vout_hold_2ms_v",
      "unit": "V"
    },
    {
      "expr": "op1.vout_disabled_static_v",
      "name": "meas_vout_disabled_static_v",
      "unit": "V"
    },
    {
      "expr": "op3.ivout_held_1v8_ua",
      "name": "meas_ivout_held_1v8_ua",
      "unit": "uA"
    }
  ],
  "models": {
    "lib": "libs.tech/combined/sky130.lib.spice",
    "pdk": "sky130A"
  },
  "netlist": "<worktree>/sim/build/enable-shutdown/20261124-120249-8be67b45.ephemeral-1780259/klt-requests/v3.30.spice",
  "options": {
    "keep_artifacts": true,
    "ngspice_init": [
      "* ngspice init settings for the sky130 PDK model libraries.",
      "*",
      "* The corner runner copies this file into its scratch run directory as",
      "* `.spiceinit` before invoking ngspice, so runs do not depend on whatever",
      "* happens to be in ~/.spiceinit. To drive ngspice by hand with the same",
      "* settings, copy this file to `.spiceinit` in your working directory.",
      "*",
      "* Same settings as the sibling sky130-bandgap harness (same PDK, same pin):",
      "* derived from the PDK's own libs.tech/ngspice/spinit, kept in-repo so the",
      "* settings a record was produced under are versioned with the harness.",
      "set ngbehavior=hsa     ; HSPICE-ish compatibility, required to read PDK libs",
      "set skywaterpdk        ; skip some checks for faster lib loading",
      "set ng_nomodcheck      ; do not check model parameters",
      "option noinit          ; do not dump operating point data into the log",
      "option klu             ; KLU direct linear solver"
    ],
    "timeout_s": 300
  }
}
