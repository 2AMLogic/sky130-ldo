*.raw
*.log
!sim/loop-gain/diagnostics/*/runs/*/ngspice.log
# dropout-vs-load/ diagnostics (issue #357): the raw per-run solver logs (incl. failed/invalid
# attempts and the merged investigation log) are committed evidence behind provenance.json.
!sim/dropout-vs-load/diagnostics/*/runs/*/ngspice.log
!sim/dropout-vs-load/diagnostics/*/runs/*/ngspice.merged.log
# issue #374: real klt engine logs captured as dropout batch-adapter test fixtures.
!sim/tests/fixtures/issue-374/*.ngspice.log
__pycache__/
.DS_Store

# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail, see sim/README.md), so they escape the *.log rule.
!sim/*/corners/**/*.log
# layout/folded-res-qual/ records (issue #253): the ngspice .op log and the
# PDK signoff runset logs are committed evidence too.
!layout/folded-res-qual/reports/**/*.log
# layout/cap-study/ records (issue #319): the per-run ngspice logs carry the
# convergence evidence for the operating-point and C(V) runs.
!layout/cap-study/*/**/*.log
# harness scratch: regenerated netlists and generated corner decks
sim/build/
# Evidence-store staging (issue #436): new-run bytes are staged here, pushed to
# the artifact store by `klt artifact put`, and never committed.
sim/.work/
# ngspice model-check scratch dumps (e.g. bsim4v5.out) from ad hoc ngspice
# invocations at repo root -- the harness never writes here, it always runs
# under sim/build/ (see sim/bin/corner-run.py). Root-anchored so it doesn't
# clobber unrelated *.out files elsewhere in the tree.
/*.out

# layout/ DRC/LVS flow: local klt install, created by layout/bin/setup-venv.sh
layout/.venv/
# layout/ ERC supply-spec flow: its own klt install on its own pin
# (layout/erc-requirements.txt explains why the pins differ)
layout/.venv-erc/
# layout/ MiM-capacitor + rail overlay demonstrator: its own klt pin
# (layout/cap-requirements.txt explains why)
layout/.venv-cap/
